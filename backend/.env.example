PORT=3000
API_PUBLIC_URL=https://api.example.com
ADMIN_ORIGIN=https://admin.example.com
FIREBASE_PROJECT_ID=developify-5615a
FIREBASE_STORAGE_BUCKET=
# Inject FIREBASE_SERVICE_ACCOUNT_JSON from Secret Manager at runtime; never commit its value.
# For local development, set FIREBASE_SERVICE_ACCOUNT_PATH to the downloaded JSON file outside the repository.
# Leave unset when running on a Google Cloud service account with Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_PATH=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@developify.co.za
WITHDRAWAL_FEE_CENTS=150
OTP_TTL_MINUTES=15
QUOTE_TTL_MINUTES=10
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
PAYMENT_PROVIDER=manual
KYC_PROVIDER=manual
