DATABASE_URL=postgresql://developify:developify@localhost:5432/developify?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000
API_PUBLIC_URL=https://api.example.com
ADMIN_ORIGIN=https://admin.example.com
FIREBASE_PROJECT_ID=developify-5615a
# Inject FIREBASE_SERVICE_ACCOUNT_JSON from Secret Manager at runtime; never commit its value.
# For local development, set FIREBASE_SERVICE_ACCOUNT_PATH to the downloaded JSON file outside the repository.
# Leave unset when running on a Google Cloud service account with Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_PATH=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@developify.co.za
S3_ENDPOINT=
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=developify-documents
S3_FORCE_PATH_STYLE=false
WITHDRAWAL_FEE_CENTS=150
OTP_TTL_MINUTES=15
QUOTE_TTL_MINUTES=10
SEED_ADMIN_EMAIL=admin@developify.co.za
SEED_ADMIN_PASSWORD=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
PAYMENT_PROVIDER=manual
KYC_PROVIDER=manual
